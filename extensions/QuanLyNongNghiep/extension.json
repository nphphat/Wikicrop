{
    "name": "QuanLyNongNghiep",
    "version": "1.0.0",
    "author": "Nguyen Phuoc Phat",
    "description": "Extension để quản lý danh sách website/youtube nông nghiệp",
    "type": "specialpage",
    "requires": {
        "MediaWiki": ">= 1.35"
    },
    "AutoloadClasses": {
        "SpecialQuanLyNongNghiep": "includes/SpecialQuanLyNongNghiep.php",
        "QuanLyNongNghiepHooks": "includes/QuanLyNongNghiepHooks.php"
    },
    "AvailableRights": [
        "editer"
    ],
    "GroupPermissions": {
        "sysop": {
            "editer": true
        }
    },
    "SpecialPages": {
        "QuanLyNongNghiep": "SpecialQuanLyNongNghiep"
    },
    "Hooks": {
        "LoadExtensionSchemaUpdates": "QuanLyNongNghiepHooks::onLoadExtensionSchemaUpdates"
    },
    "MessagesDirs": {
        "QuanLyNongNghiep": [
            "i18n"
        ]
    },
    "ResourceModules": {
        "ext.quanlynongnghiep": {
            "localBasePath": "",
            "remoteExtPath": "QuanLyNongNghiep",
            "scripts": "modules/ext.quanlynongnghiep.js",
            "styles": "modules/ext.quanlynongnghiep.css"
        }
    },
    "manifest_version": 2
}