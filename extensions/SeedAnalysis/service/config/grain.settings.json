{
  "pipeline": "yolo8_nano_segment",
  "params": {
    "pipeline":               { "type": "string",  "default": "yolo8_nano_segment" },
    "maxSide":                { "type": "number",  "default": 1024,   "min": 128,  "max": 4096 },

    "yoloModelPath":          { "type": "string",  "default": "main_model/best.onnx", "env": "GRAIN_YOLO_MODEL" },
    "yoloConf":               { "type": "number",  "default": 0.04,   "min": 0.01, "max": 0.99 },
    "yoloIou":                { "type": "number",  "default": 0.70,   "min": 0.05, "max": 0.95 },
    "yoloImgSize":            { "type": "number",  "default": 1024,   "min": 160,  "max": 2048 },
    "yoloMaxDet":             { "type": "number",  "default": 5000,   "min": 1,    "max": 5000 },
    "maskThreshold":          { "type": "number",  "default": 0.50,   "min": 0.05, "max": 0.95 },
    "longMaskThreshold":      { "type": "number",  "default": 0.40,   "min": 0.05, "max": 0.95 },
    "longMaskAspectRatio":    { "type": "number",  "default": 2.15,   "min": 1,    "max": 20 },
    "maskCropPaddingRatio":   { "type": "number",  "default": 0.01,   "min": 0,    "max": 0.30 },
    "longMaskCropPaddingRatio": { "type": "number", "default": 0.08,  "min": 0,    "max": 0.30 },

    "enableTiledInference":   { "type": "boolean", "default": false },
    "enableFullImagePass":    { "type": "boolean", "default": true },
    "tileSize":               { "type": "number",  "default": 512,    "min": 160,  "max": 2048 },
    "tileOverlap":            { "type": "number",  "default": 0.25,   "min": 0,    "max": 0.8 },
    "enableTinyTilePass":     { "type": "boolean", "default": false },
    "tinyTileSize":           { "type": "number",  "default": 320,    "min": 160,  "max": 1024 },
    "mergeIou":               { "type": "number",  "default": 0.35,   "min": 0.05, "max": 0.95 },
    "mergeOverlap":           { "type": "number",  "default": 0.70,   "min": 0.05, "max": 1.0 },
    "edgeMarginRatio":        { "type": "number",  "default": 0.1,    "min": 0,    "max": 0.4 },

    "enableGrabCut":          { "type": "boolean", "default": false },
    "grabCutIter":            { "type": "number",  "default": 1,      "min": 1,    "max": 10 },
    "enableEdgeSnap":         { "type": "boolean", "default": false },
    "edgeSnapRadius":         { "type": "number",  "default": 6,      "min": 1,    "max": 20 },
    "edgeSnapSigma":          { "type": "number",  "default": 1.5,    "min": 0.5,  "max": 5.0 },
    "maskContourSmooth":      { "type": "number",  "default": 0,      "min": 0,    "max": 5 },
    "enableBoundaryRefine":   { "type": "boolean", "default": false },
    "boundaryRefinePadding":  { "type": "number",  "default": 8,      "min": 0,    "max": 64 },
    "boundaryRefineRadius":   { "type": "number",  "default": 4,      "min": 1,    "max": 12 },
    "boundaryRefineMaxAreaChange": { "type": "number", "default": 0.45, "min": 0, "max": 1 },
    "enableMorphSplit":       { "type": "boolean", "default": false },
    "morphSplitMinArea":      { "type": "number",  "default": 300,    "min": 1,    "max": 1000000 },
    "morphSplitKernel":       { "type": "number",  "default": 3,      "min": 1,    "max": 15 },
    "morphSplitMaxComponents":{ "type": "number",  "default": 3,      "min": 2,    "max": 8 },
    "morphSplitMinComponentAreaRatio": { "type": "number", "default": 0.08, "min": 0.01, "max": 0.45 },
    "enableSkinReject":       { "type": "boolean", "default": true },
    "skinRejectRatio":        { "type": "number",  "default": 0.58,   "min": 0,    "max": 1 },
    "strongSkinRejectRatio":  { "type": "number",  "default": 0.72,   "min": 0,    "max": 1 },
    "enableAdaptiveThresholds": { "type": "boolean", "default": true },
    "adaptiveMinCandidates":  { "type": "number",  "default": 8,      "min": 3,    "max": 200 },
    "adaptiveMadZ":           { "type": "number",  "default": 5.0,    "min": 1,    "max": 12 },
    "dynamicAreaMultiplier":  { "type": "number",  "default": 8.0,    "min": 1,    "max": 50 },
    "enableMergedSeedSplit":  { "type": "boolean", "default": true },
    "mergedSplitAreaRatio":   { "type": "number",  "default": 1.45,   "min": 1,    "max": 6 },
    "mergedSplitLengthRatio": { "type": "number",  "default": 1.22,   "min": 1,    "max": 4 },
    "mergedSplitWidthRatio":  { "type": "number",  "default": 1.32,   "min": 1,    "max": 4 },
    "mergedSplitMadZ":        { "type": "number",  "default": 3.0,    "min": 1,    "max": 8 },
    "mergedSplitMaxParts":    { "type": "number",  "default": 4,      "min": 2,    "max": 8 },

    "enableFragmentMerge":    { "type": "boolean", "default": true },
    "fragmentMergeMaxGapRatio": { "type": "number", "default": 0.08,  "min": 0,    "max": 2 },
    "fragmentMergeMaxAreaRatio": { "type": "number", "default": 1.28, "min": 1,    "max": 3 },
    "fragmentMergeMinAreaRatio": { "type": "number", "default": 0.65, "min": 0,    "max": 1 },
    "fragmentMergeMaxLengthRatio": { "type": "number", "default": 1.20, "min": 1, "max": 3 },
    "fragmentMergeMaxWidthRatio": { "type": "number", "default": 1.22, "min": 1, "max": 3 },

    "enableClassicalFallback": { "type": "boolean", "default": true },
    "classicalFallbackMaxYoloCandidates": { "type": "number", "default": 12, "min": 0, "max": 5000 },
    "classicalFallbackMinCandidates": { "type": "number", "default": 25, "min": 1, "max": 5000 },
    "classicalFallbackMaxAdded": { "type": "number", "default": 180, "min": 1, "max": 5000 },
    "classicalFallbackConfidence": { "type": "number", "default": 0.085, "min": 0.01, "max": 0.50 },
    "classicalFallbackBrightPercentile": { "type": "number", "default": 96, "min": 70, "max": 99.5 },
    "classicalFallbackMinBrightDelta": { "type": "number", "default": 6, "min": 0, "max": 80 },
    "classicalFallbackBackgroundSigma": { "type": "number", "default": 15, "min": 3, "max": 80 },
    "classicalFallbackDilateIterations": { "type": "number", "default": 1, "min": 0, "max": 3 },
    "classicalFallbackMaxAspect": { "type": "number", "default": 18, "min": 2, "max": 50 },

    "enableReferenceRecovery": { "type": "boolean", "default": true },
    "referenceRecoveryMinAreaRatio": { "type": "number", "default": 4.0, "min": 1.5, "max": 30 },
    "referenceRecoveryMaxAspect": { "type": "number", "default": 1.55, "min": 1.0, "max": 3.0 },
    "referenceRecoveryMinCircularity": { "type": "number", "default": 0.52, "min": 0.1, "max": 1.2 },
    "referenceRecoveryMinRadiusRatio": { "type": "number", "default": 0.05, "min": 0.01, "max": 0.2 },
    "referenceRecoveryMaxRadiusRatio": { "type": "number", "default": 0.10, "min": 0.02, "max": 0.3 },
    "referenceRecoveryHoughThreshold": { "type": "number", "default": 22, "min": 5, "max": 100 },
    "referenceRecoveryMinContrast": { "type": "number", "default": 3, "min": -50, "max": 100 },
    "referenceRecoveryMaxBackgroundLuma": { "type": "number", "default": 150, "min": 0, "max": 255 },

    "preprocessImage":        { "type": "boolean", "default": false },
    "whiteBalanceStrength":   { "type": "number",  "default": 0.25,   "min": 0,    "max": 1 },
    "claheClipLimit":         { "type": "number",  "default": 2.5,    "min": 0,    "max": 6 },
    "claheTileSize":          { "type": "number",  "default": 5,      "min": 2,    "max": 32 },
    "denoiseStrength":        { "type": "number",  "default": 0.1,    "min": 0,    "max": 1 },
    "denoiseDiameter":        { "type": "number",  "default": 5,      "min": 3,    "max": 15 },

    "minArea":                { "type": "number",  "default": 20,     "min": 1,    "max": 1000000 },
    "maxArea":                { "type": "number",  "default": 200000, "min": 1,    "max": 100000000 },
    "maxSegmentAspectRatio":  { "type": "number",  "default": 14,     "min": 1,    "max": 200 },
    "minSegmentSolidity":     { "type": "number",  "default": 0.5,    "min": 0,    "max": 1 },
    "minSegmentExtent":       { "type": "number",  "default": 0.2,    "min": 0,    "max": 1 },

    "referencePixels":        { "type": "number",  "default": 0,      "min": 0,    "max": 1000000 },
    "referenceMm":            { "type": "number",  "default": 0,      "min": 0,    "max": 1000000 },
    "referencePixelSpace":    { "type": "string",  "default": "original" },
    "referenceX1":            { "type": "number",  "default": -1,     "min": -1,   "max": 1000000 },
    "referenceY1":            { "type": "number",  "default": -1,     "min": -1,   "max": 1000000 },
    "referenceX2":            { "type": "number",  "default": -1,     "min": -1,   "max": 1000000 },
    "referenceY2":            { "type": "number",  "default": -1,     "min": -1,   "max": 1000000 }
  },
  "csvColumns": [
    "id", "area_px", "length_px", "width_px",
    "area_mm2", "length_mm", "width_mm",
    "centroid_x", "centroid_y",
    "bbox_x", "bbox_y", "bbox_w", "bbox_h",
    "angle_deg", "solidity", "extent", "aspect_ratio", "measurement_method",
    "confidence", "class_id", "class_name", "detected_class_id", "detected_class_name",
    "quality_flags", "qc_outlier", "qc_reason"
  ],
  "palette": [
    [45,  108, 191],
    [219,  87,  86],
    [73,  160, 120],
    [235, 174,  73],
    [132,  98, 174],
    [77,  176, 196],
    [201, 112, 165],
    [122, 126, 135]
  ]
}
